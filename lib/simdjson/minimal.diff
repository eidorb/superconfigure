--- simdjson-3.12.3/CMakeLists.txt
+++ simdjson-3.12.3/CMakeLists.txt
@@ -101,9 +101,12 @@
 simdjson_add_props(target_compile_features PUBLIC cxx_std_11)
 
 # workaround for GNU GCC poor AVX load/store code generation
+# CMAKE_SYSTEM_PROCESSOR is the *host* CPU when cosmocc is used without a
+# toolchain file, so also reject an aarch64 compiler by name.
 if(
     CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
     AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(i.86|x86(_64)?)$"
+    AND NOT CMAKE_CXX_COMPILER MATCHES "aarch64"
 )
   simdjson_add_props(
       target_compile_options PRIVATE
